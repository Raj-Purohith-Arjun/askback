# These are the environment variables askback reads. askback does NOT load a .env file:
# nothing in it reads one, so copying this file does nothing by itself. Export what you need in
# your shell, or load the file with your own tooling first, e.g. (bash):
#
#     set -a; source .env; set +a
#
# Every variable here is optional. With none set, `askback eval` grades the built-in demo.
# Your config file refers to them as ${VAR} or ${VAR:default}.

# --- your agent ------------------------------------------------------------- #
# Only if your config file mentions them, as config/askback.example.yaml does.
# AGENT_URL=https://agent.example.com/api/chat
# AGENT_TOKEN=

# --- the judge (optional; the free heuristic judge grades without one) ------- #
# The judge's own model and credentials. Always JUDGE_-prefixed: it never reads the agent's.
#
# 1. A model you run yourself (vLLM, Ollama, LiteLLM, a company gateway). No key is needed.
#    Use with `llm: {provider: openai}` in the judge block.
# JUDGE_OPENAI_BASE_URL=http://localhost:11434/v1
# JUDGE_OPENAI_MODEL=llama3
#
# 2. OpenAI itself:
# JUDGE_OPENAI_API_KEY=
#
# 3. Azure OpenAI:
# JUDGE_AZURE_OPENAI_ENDPOINT=
# JUDGE_AZURE_OPENAI_API_KEY=
# JUDGE_AZURE_OPENAI_DEPLOYMENT=
#
# 4. Anthropic (there is no default model: name yours):
# JUDGE_ANTHROPIC_API_KEY=
# JUDGE_ANTHROPIC_MODEL=
#
# The same variables with a PERSONA_ prefix configure the simulated user for clarification
# cases (PERSONA_OPENAI_BASE_URL, PERSONA_OPENAI_MODEL, ...).

# --- operations ------------------------------------------------------------- #
# ASKBACK_CONFIG=path/to/your-config.yaml   # used when --config is not given
# ASKBACK_HOME=/path/to/project             # what relative paths in a config are relative to
# ASKBACK_EVAL_WORKERS=4
# ASKBACK_LOG_LEVEL=INFO
# ASKBACK_LOG_JSON=0                        # 1 = one JSON object per log line

# --- the HR example only (examples/hr/config.yaml) --------------------------- #
# ASKBACK_LLM_PROVIDER=extractive           # the example simulator's own model
# ASKBACK_ROUTER=keyword
# ASKBACK_CORPUS_PATH=examples/hr/corpus
# ASKBACK_PII_REDACTION=false
# `askback serve` (the example's dashboard):
# ASKBACK_HOST=127.0.0.1
# ASKBACK_PORT=8000
# ASKBACK_API_KEY=                          # set on any non-local deployment
# ASKBACK_ALLOW_RUNTIME_RELOAD=false

# --- set by CI, not by you ---------------------------------------------------- #
# CI=true  makes `--redaction full` refuse to run, so a CI artifact never holds full transcripts.
